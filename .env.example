# ══════════════════════════════════════════════════════
# Bot Moderador Valak Search - Configurações
# ══════════════════════════════════════════════════════

# Token do bot (obtenha em @BotFather)
BOT_TOKEN=your_bot_token_here

# ID do grupo (número negativo, obtenha com @userinfobot)
GROUP_ID=-1002603662151

# ID do admin (obtenha com @userinfobot)
ADMIN_ID=seu_user_id_aqui

# URL do WebApp hospedado (onde está o index.html)
WEBAPP_URL=https://seu-dominio.com

# Porta do servidor (padrão: 8000)
PORT=8000

# ══════════════════════════════════════════════════════
# MENSAGENS PERIÓDICAS
# ══════════════════════════════════════════════════════

# Agendamento das mensagens (formato cron)
# Exemplos:
#   */30 * * * *    = a cada 30 minutos
#   0 */2 * * *     = a cada 2 horas
#   0 9,15,21 * * * = às 9h, 15h e 21h todos os dias
#   0 */3 * * *     = a cada 3 horas (padrão)
CRON_SCHEDULE=0 */3 * * *

# Mensagens que serão enviadas (separadas por |||)
# As mensagens são enviadas em rodízio (rotação circular)
# Use emojis e HTML para formatação
PERIODIC_MESSAGES=📢 Lembre-se de seguir as regras do grupo!|||🎯 Participe das discussões de forma respeitosa!|||⭐ Ajude a manter o grupo organizado!

# ══════════════════════════════════════════════════════
# NOTAS
# ══════════════════════════════════════════════════════
# - Não commite o arquivo .env (use este .env.example como referência)
# - O bot precisa ser Admin do grupo com permissões de restringir membros
# - Use HTTPS no WEBAPP_URL para produção
# - Mantenha o BOT_TOKEN em segredo
